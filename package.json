{
  "name": "cardtable-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cardtable/playground dev",
    "scenarios": "pnpm --silent --filter @cardtable/scenarios start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @yannikmesserli/cards build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
